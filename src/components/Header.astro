---
import { NAV_ITEMS, SITE, type PageId } from "../config";

interface Props {
  /** Current page — highlights its nav item. */
  active: PageId;
}
const { active } = Astro.props;
---

<header class="hdr">
  <a href="/" class="hdr-home-link">
    <img src="/assets/logo-white.png" alt="DeepSpeed" style="height:38px;display:block" />
    <span class="wm">DeepSpeed</span>
  </a>
  <nav class="hdr-nav" id="hdr-nav" aria-label="Main">
    {NAV_ITEMS.map((item) => (
      <a href={item.href} class:list={{ on: item.id === active }}>{item.label}</a>
    ))}
  </nav>
  <div class="hdr-right">
    <img
      src="/assets/ntu-ccds-header-white.png"
      alt="Nanyang Technological University College of Computing and Data Science"
      class="hdr-ntu-logo"
    />
    {SITE.showLiveChip && <span class="live-chip"><span class="d"></span>Live</span>}
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="hdr-nav" aria-label="Open menu">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
</header>

<script>
  import { animate } from "motion/mini";
  import { stagger } from "motion";
  import { EASE_MECH, hasMotion } from "../scripts/prefs";

  const hdr = document.querySelector<HTMLElement>(".hdr");
  const toggle = hdr?.querySelector<HTMLButtonElement>(".nav-toggle");
  const links = Array.from(hdr?.querySelectorAll<HTMLAnchorElement>("#hdr-nav a") ?? []);
  if (hdr && toggle) {
    const setOpen = (open: boolean) => {
      hdr.classList.toggle("nav-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      // Mobile dropdown: the panel slides via CSS; the links cascade in behind it.
      if (open && hasMotion && links.length) {
        animate(
          links,
          { opacity: [0, 1], transform: ["translateX(-10px)", "none"] },
          { duration: 0.28, delay: stagger(0.045), ease: EASE_MECH },
        );
      }
    };
    toggle.addEventListener("click", () => setOpen(!hdr.classList.contains("nav-open")));
    document.addEventListener("click", (e) => {
      if (hdr.classList.contains("nav-open") && !hdr.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  }
</script>
